JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Copy backend/.env.example to backend/.env and fill in values.

# Generate with: npm run push:keys (run from project root)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
TZ=Asia/Kolkata

# Email address of the single administrator account (must register with this email)
ADMIN_EMAIL=your-admin-email@example.com
# Separate password required to unlock the admin portal (use a unique long password)
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
